{
  "name": "goal-reacher_frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "node envChecker.mjs && next dev -p 3200",
    "build": "next build",
    "start": "next start -p 3200",
    "lint": "next lint",
    "lint:fix": "next lint --fix",
    "prepare": "husky",
    "test:jest": "next build && concurrently \"yarn start\" \"yarn jest-test:full\"",
    "test:mocha": "next build && concurrently \"yarn start\" \"yarn mocha-test:full\"",
    "mocha-test:full": "tsc -p mocha-tests/tsconfig.tests.json && sleep 5 && mocha 'mocha-tests/compiled/**/*.js' --no-timeouts",
    "jest-test:full": "sleep 5 && jest",
    "cy:open": "cypress open"
  },
  "dependencies": {
    "@hookform/resolvers": "^3.7.0",
    "axios": "^1.7.2",
    "classnames": "^2.5.1",
    "dotenv": "^16.4.5",
    "next": "14.2.3",
    "react": "^18",
    "react-dom": "^18",
    "react-hook-form": "^7.52.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.4.6",
    "@testing-library/react": "^16.0.0",
    "@types/jest": "^29.5.12",
    "@types/mocha": "^10.0.7",
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "@types/selenium-webdriver": "^4.1.24",
    "@typescript-eslint/eslint-plugin": "^7.11.0",
    "concurrently": "^8.2.2",
    "cypress": "13.16.0",
    "eslint": "^8",
    "eslint-config-next": "14.2.3",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "husky": "^9.0.11",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "mocha": "^10.6.0",
    "postcss": "^8",
    "prettier": "^3.2.5",
    "sass": "^1.77.2",
    "selenium-webdriver": "^4.22.0",
    "tailwindcss": "^3.4.1",
    "ts-node": "^10.9.2",
    "typescript": "^5"
  }
}
